# Copy this file to ".env" (same folder) and fill in your values. ".env" is git-ignored.
# Windows:  copy .env.example .env
# Mac/Linux: cp .env.example .env

# Database (these match docker-compose.yml; change DB_PASSWORD if you use your own local PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/breathingroom
DB_USERNAME=postgres
DB_PASSWORD=postgres

# OpenAI (optional - leave blank to use the built-in explanations)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Login security: a long random value (32+ characters) used to sign login tokens. Keep it secret.
JWT_SECRET=
# Optional: websites allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
